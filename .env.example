# Estate Intelligence AI — Environment Configuration

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary Free Model on OpenRouter (Free Models Router + explicit :free fallback chain)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,thinkingmachines/inkling-2-small:free

# Vector Store & Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=./data/vector_db
SCRAPED_DATA_DIR=./data/scraped
PROCESSED_DATA_DIR=./data/processed

# Server & CORS Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Scraper Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; EstateIntelligenceBot/1.0; +https://darglobal.co.uk)
SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=20
